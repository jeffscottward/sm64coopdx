#==============================================================================#
# Makefile.web — Emscripten/WebAssembly wrapper for sm64coopdx                #
#==============================================================================#
#
# Usage:
#   gmake -f Makefile.web              # Build web version
#   gmake -f Makefile.web clean-web    # Clean web build artifacts
#   gmake -f Makefile.web -j$(nproc)   # Parallel build
#
# Prerequisites:
#   1. GNU Make 4.x+ ('gmake' on macOS — install via 'brew install make')
#      The main Makefile uses the != operator which requires GNU Make 4.0+.
#      macOS ships GNU Make 3.81 which does not support this.
#   2. Emscripten SDK (emsdk) installed and activated:
#        source /path/to/emsdk/emsdk_env.sh
#      Verify: 'emcc --version' should work
#   3. baserom.us.z64 in the project root
#   4. Python 3 available as 'python3'
#
# This wrapper invokes the main Makefile with Emscripten-specific overrides.
# It sets the compiler toolchain to emcc/em++, disables native-only features
# (Discord SDK, CoopNet, update checker), and configures SDL2/OpenGL ES/WASM
# output via Emscripten ports.
#
#==============================================================================#

# Build output directory for web
BUILD_DIR_WEB := build/us_web

# Require GNU Make 4.x+ for != operator support
# On macOS, use 'gmake' (brew install make). On Linux, 'make' is usually 4.x+.
GMAKE := $(shell which gmake 2>/dev/null || which make)

# Emscripten compiler toolchain
EMCC  := emcc
EMXX  := em++
EMAR  := emar

# Emscripten port flags (used in both compile and link stages)
EM_PORT_FLAGS := -s USE_SDL=2 -s USE_ZLIB=1 -s FULL_ES2=1

# Emscripten threading flags
# Single-threaded mode: thread.c provides no-op stubs for web, so we do NOT
# enable USE_PTHREADS. This avoids the SharedArrayBuffer requirement (which
# needs COOP/COEP server headers and has limited browser support).
EM_THREAD_FLAGS :=

# Extra C flags for web builds
# Include -Wno-format-security -Wno-trigraphs from the main Makefile since
# command-line overrides prevent the main Makefile's += from appending them.
WEB_EXTRA_CFLAGS := \
	-Wno-format-security \
	-Wno-trigraphs \
	-DTARGET_WEB=1 \
	-DUSE_GLES=1 \
	$(EM_PORT_FLAGS) \
	$(EM_THREAD_FLAGS)

# Emscripten linker flags
WEB_LDFLAGS := \
	-s WASM=1 \
	-s ALLOW_MEMORY_GROWTH=1 \
	-s TOTAL_MEMORY=256MB \
	$(EM_PORT_FLAGS) \
	$(EM_THREAD_FLAGS) \
	-s EXPORTED_RUNTIME_METHODS='["ccall","cwrap"]' \
	-s FORCE_FILESYSTEM=1 \
	-s ASYNCIFY \
	-s ASYNCIFY_STACK_SIZE=65536 \
	--preload-file $(BUILD_DIR_WEB)/lang@/lang \
	--preload-file $(BUILD_DIR_WEB)/dynos@/dynos \
	--shell-file src/pc/web/shell.html \
	-lidbfs.js

# Variables passed to the main Makefile
# Note: The main Makefile uses ?= for most options, so setting them via
# environment or command line will override the defaults.
MAKE_OVERRIDES := \
	CC="$(EMCC)" \
	CXX="$(EMXX)" \
	LD="$(EMXX)" \
	AR="$(EMAR)" \
	CPP="$(EMCC) -E -P -x c" \
	CROSS="" \
	DISCORD_SDK=0 \
	COOPNET=0 \
	RENDER_API=GL \
	WINDOW_API=SDL2 \
	AUDIO_API=SDL2 \
	CONTROLLER_API=SDL2 \
	HEADLESS=0 \
	TARGET_N64=0 \
	OSX_BUILD=0 \
	WINDOWS_BUILD=0 \
	TARGET_RPI=0 \
	TARGET_RK3588=0 \
	OPT_FLAGS="-O2 -g" \
	BUILD_DIR="$(BUILD_DIR_WEB)" \
	EXE="$(BUILD_DIR_WEB)/sm64coopdx.html" \
	EXTRA_CFLAGS="$(WEB_EXTRA_CFLAGS)" \
	LDFLAGS="$(WEB_LDFLAGS)" \
	COMPILER=gcc

#==============================================================================#
# Targets                                                                      #
#==============================================================================#

.PHONY: web clean-web

# Default target
web:
	@echo "=========================================="
	@echo " Building sm64coopdx for WebAssembly"
	@echo "=========================================="
	@echo ""
	@# Verify GNU Make 4.x+ is available (needed for != operator)
	@$(GMAKE) --version | head -1 | grep -qE 'GNU Make [4-9]\.' || \
		(echo "ERROR: GNU Make 4.x+ required (found: $$($(GMAKE) --version | head -1))." && \
		 echo "On macOS: brew install make  (then use 'gmake')" && \
		 exit 1)
	@# Verify emcc is available
	@which emcc > /dev/null 2>&1 || \
		(echo "ERROR: emcc not found in PATH." && \
		 echo "Please install and activate the Emscripten SDK:" && \
		 echo "  source /path/to/emsdk/emsdk_env.sh" && \
		 exit 1)
	@echo "Using GNU Make: $$($(GMAKE) --version | head -1)"
	@echo "Using Emscripten: $$(emcc --version | head -1)"
	@echo ""
	$(GMAKE) --no-builtin-rules -f Makefile $(MAKE_OVERRIDES)
	@echo ""
	@echo "=========================================="
	@echo " Build complete!"
	@echo " Output: $(BUILD_DIR_WEB)/sm64coopdx.html"
	@echo "         $(BUILD_DIR_WEB)/sm64coopdx.js"
	@echo "         $(BUILD_DIR_WEB)/sm64coopdx.wasm"
	@echo ""
	@echo " To test locally:"
	@echo "   cd $(BUILD_DIR_WEB) && python3 -m http.server 8080"
	@echo "   Open http://localhost:8080/sm64coopdx.html"
	@echo "=========================================="

clean-web:
	@echo "Cleaning web build artifacts..."
	rm -rf $(BUILD_DIR_WEB)
	@echo "Done."
