#==============================================================================#
# Makefile.web — Emscripten/WebAssembly wrapper for sm64coopdx                #
#==============================================================================#
#
# Usage:
#   gmake -f Makefile.web              # Build web version
#   gmake -f Makefile.web clean-web    # Clean web build artifacts
#   gmake -f Makefile.web -j$(nproc)   # Parallel build
#   gmake -f Makefile.web WEB_DEBUG=1  # Build with ASSERTIONS=2 + SAFE_HEAP
#
# Serving locally:
#   python3 serve_web.py               # Serve with COOP/COEP headers (port 8080)
#   python3 serve_web.py --port 3000   # Custom port
#   python3 serve_web.py --dir build/us_web  # Custom build directory
#
# Prerequisites:
#   1. GNU Make 4.x+ ('gmake' on macOS — install via 'brew install make')
#      The main Makefile uses the != operator which requires GNU Make 4.0+.
#      macOS ships GNU Make 3.81 which does not support this.
#   2. Emscripten SDK (emsdk) installed and activated:
#        source /path/to/emsdk/emsdk_env.sh
#      Verify: 'emcc --version' should work
#   3. baserom.us.z64 in the project root
#   4. Python 3 available as 'python3'
#
# This wrapper invokes the main Makefile with Emscripten-specific overrides.
# It sets the compiler toolchain to emcc/em++, disables native-only features
# (Discord SDK, CoopNet, update checker), and configures SDL2/OpenGL ES/WASM
# output via Emscripten ports.
#
#==============================================================================#

# Build output directory for web
BUILD_DIR_WEB := build/us_web

# Require GNU Make 4.x+ for != operator support
# On macOS, use 'gmake' (brew install make). On Linux, 'make' is usually 4.x+.
GMAKE := $(shell which gmake 2>/dev/null || which make)

# Emscripten compiler toolchain
EMCC  := emcc
EMXX  := em++
EMAR  := emar

# Emscripten port flags (used in both compile and link stages)
EM_PORT_FLAGS := -s USE_SDL=2 -s USE_ZLIB=1 -s FULL_ES2=1

# Emscripten threading flags
# Single-threaded mode: thread.c provides no-op stubs for web, so we do NOT
# enable USE_PTHREADS. This avoids the SharedArrayBuffer requirement (which
# needs COOP/COEP server headers and has limited browser support).
EM_THREAD_FLAGS :=

# Build-time WebSocket relay URL override
# Set SM64_WS_RELAY to bake a production relay URL into the build.
# Example: gmake -f Makefile.web SM64_WS_RELAY=wss://relay.example.com
# If not set, the game uses the configWebSocketRelay value (default ws://localhost:8765).
SM64_WS_RELAY ?=

WS_RELAY_FLAG :=
ifneq ($(SM64_WS_RELAY),)
WS_RELAY_FLAG := -DSM64_WS_RELAY_URL=\\\"$(SM64_WS_RELAY)\\\"
endif

# Extra C flags for web builds
# Include -Wno-format-security -Wno-trigraphs from the main Makefile since
# command-line overrides prevent the main Makefile's += from appending them.
WEB_EXTRA_CFLAGS := \
	-Wno-format-security \
	-Wno-trigraphs \
	-DTARGET_WEB=1 \
	-DUSE_GLES=1 \
	$(WS_RELAY_FLAG) \
	$(EM_PORT_FLAGS) \
	$(EM_THREAD_FLAGS)

# Lua 5.3 compiled from source for Emscripten
# The precompiled native .a files in lib/lua/linux/ etc. are x86/ARM — incompatible
# with WASM. We compile Lua 5.3.5 source (in lib/lua/src/) with emcc and archive
# with emar into lib/lua/web/liblua53.a.
LUA_SRC_DIR   := lib/lua/src
LUA_WEB_DIR   := lib/lua/web
LUA_WEB_LIB   := $(LUA_WEB_DIR)/liblua53.a
LUA_INC_DIR   := lib/lua/include

# All Lua library source files (excluding lua.c and luac.c which contain main())
LUA_SRC_FILES := $(filter-out $(LUA_SRC_DIR)/lua.c $(LUA_SRC_DIR)/luac.c, \
	$(wildcard $(LUA_SRC_DIR)/*.c))
LUA_OBJ_FILES := $(LUA_SRC_FILES:$(LUA_SRC_DIR)/%.c=$(LUA_WEB_DIR)/%.o)

# Emscripten linker flags
# Note: The command-line LDFLAGS override prevents the main Makefile from adding
# native flags (-lcurl, -ldl, -lpthread, -latomic, -lz, -rdynamic, -no-pie,
# -march=native, -l:liblua53.a). This is intentional — Emscripten ports provide
# zlib (-s USE_ZLIB=1), SDL2 (-s USE_SDL=2), and OpenGL ES (-s FULL_ES2=1).
# Native-only libraries (curl, pthread, dl, atomic) are not needed for web builds.
# Debug mode: set WEB_DEBUG=1 to enable Emscripten assertions and better errors.
# This adds ASSERTIONS=2, SAFE_HEAP, and STACK_OVERFLOW_CHECK for debugging
# "memory access out of bounds" and "unreachable executed" crashes.
# Usage: gmake -f Makefile.web WEB_DEBUG=1
WEB_DEBUG ?= 0

WEB_DEBUG_FLAGS :=
ifeq ($(WEB_DEBUG),1)
WEB_DEBUG_FLAGS := \
	-s ASSERTIONS=2 \
	-s SAFE_HEAP=1 \
	-s STACK_OVERFLOW_CHECK=2 \
	-s DEMANGLE_SUPPORT=1
endif

WEB_LDFLAGS := \
	-s WASM=1 \
	-s ALLOW_MEMORY_GROWTH=1 \
	-s INITIAL_MEMORY=512MB \
	-s STACK_SIZE=1MB \
	$(EM_PORT_FLAGS) \
	$(EM_THREAD_FLAGS) \
	$(WEB_DEBUG_FLAGS) \
	-s EXPORTED_RUNTIME_METHODS='["ccall","cwrap"]' \
	-s EXPORTED_FUNCTIONS='["_main","_keyboard_on_all_keys_up"]' \
	-s FORCE_FILESYSTEM=1 \
	-s ASYNCIFY \
	-s ASYNCIFY_STACK_SIZE=65536 \
	--preload-file $(BUILD_DIR_WEB)/lang@/lang \
	--preload-file $(BUILD_DIR_WEB)/dynos@/dynos \
	--shell-file src/pc/web/shell.html \
	-lidbfs.js \
	-lwebsocket.js \
	-L$(LUA_WEB_DIR) -l:liblua53.a

# Variables passed to the main Makefile
# Note: The main Makefile uses ?= for most options, so setting them via
# environment or command line will override the defaults.
MAKE_OVERRIDES := \
	CC="$(EMCC)" \
	CXX="$(EMXX)" \
	LD="$(EMXX)" \
	AR="$(EMAR)" \
	CPP="$(EMCC) -E -P -x c" \
	CROSS="" \
	DISCORD_SDK=0 \
	COOPNET=0 \
	RENDER_API=GL \
	WINDOW_API=SDL2 \
	AUDIO_API=SDL2 \
	CONTROLLER_API=SDL2 \
	HEADLESS=0 \
	TARGET_N64=0 \
	OSX_BUILD=0 \
	WINDOWS_BUILD=0 \
	TARGET_RPI=0 \
	TARGET_RK3588=0 \
	OPT_FLAGS="-O2 -g" \
	BUILD_DIR="$(BUILD_DIR_WEB)" \
	EXE="$(BUILD_DIR_WEB)/sm64coopdx.html" \
	EXTRA_CFLAGS="$(WEB_EXTRA_CFLAGS)" \
	LDFLAGS="$(WEB_LDFLAGS)" \
	COMPILER=gcc

#==============================================================================#
# Targets                                                                      #
#==============================================================================#

.PHONY: web clean-web lua-web clean-lua-web

# Ensure 'web' is the default target (must be the first explicit rule)
.DEFAULT_GOAL := web

#==============================================================================#
# Lua 5.3 for Emscripten                                                      #
#==============================================================================#

# Compile individual Lua .c files to .o with emcc
$(LUA_WEB_DIR)/%.o: $(LUA_SRC_DIR)/%.c | $(LUA_WEB_DIR)
	@echo "  [emcc] Lua: $<"
	$(EMCC) -O2 -DLUA_USE_POSIX -I$(LUA_INC_DIR) -c $< -o $@

# Create the Lua static library
$(LUA_WEB_LIB): $(LUA_OBJ_FILES)
	@echo "  [emar] Creating $@"
	$(EMAR) rcs $@ $^

$(LUA_WEB_DIR):
	mkdir -p $(LUA_WEB_DIR)

lua-web: $(LUA_WEB_LIB)
	@echo "Lua 5.3 for Emscripten: $(LUA_WEB_LIB)"

clean-lua-web:
	rm -rf $(LUA_WEB_DIR)

#==============================================================================#
# Main Web Build                                                               #
#==============================================================================#

# Default target — depends on Lua being built first
web: lua-web
	@echo "=========================================="
	@echo " Building sm64coopdx for WebAssembly"
	@echo "=========================================="
	@echo ""
	@# Verify GNU Make 4.x+ is available (needed for != operator)
	@$(GMAKE) --version | head -1 | grep -qE 'GNU Make [4-9]\.' || \
		(echo "ERROR: GNU Make 4.x+ required (found: $$($(GMAKE) --version | head -1))." && \
		 echo "On macOS: brew install make  (then use 'gmake')" && \
		 exit 1)
	@# Verify emcc is available
	@which emcc > /dev/null 2>&1 || \
		(echo "ERROR: emcc not found in PATH." && \
		 echo "Please install and activate the Emscripten SDK:" && \
		 echo "  source /path/to/emsdk/emsdk_env.sh" && \
		 exit 1)
	@echo "Using GNU Make: $$($(GMAKE) --version | head -1)"
	@echo "Using Emscripten: $$(emcc --version | head -1)"
	@echo ""
	$(GMAKE) --no-builtin-rules -f Makefile $(MAKE_OVERRIDES)
	@echo ""
	@echo "=========================================="
	@echo " Build complete!"
	@echo " Output: $(BUILD_DIR_WEB)/sm64coopdx.html"
	@echo "         $(BUILD_DIR_WEB)/sm64coopdx.js"
	@echo "         $(BUILD_DIR_WEB)/sm64coopdx.wasm"
	@echo ""
	@echo " To test locally:"
	@echo "   python3 serve_web.py"
	@echo "   Open http://localhost:8080/sm64coopdx.html"
	@echo ""
	@echo " (serve_web.py adds COOP/COEP headers for SharedArrayBuffer support)"
	@echo "=========================================="

clean-web: clean-lua-web
	@echo "Cleaning web build artifacts..."
	rm -rf $(BUILD_DIR_WEB)
	@echo "Done."
